<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.harnss.voice-runtime</string>
  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/harnss-voice-bridge/scripts/run-speech-runtime.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/REPLACE/WITH/ABSOLUTE/PATH/harnss-voice-bridge</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/harnss-voice-runtime.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/harnss-voice-runtime.err.log</string>
</dict>
</plist>
